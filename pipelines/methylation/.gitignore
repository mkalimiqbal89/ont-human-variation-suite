# Real, sample-specific / machine-specific configs — NEVER commit these,
# they contain real sample identifiers and absolute local filesystem paths.
# Only the .example.yaml templates are tracked.
config/pipeline_config.yaml
config/pipeline_config_*.yaml
config/reference_paths.yaml
!config/pipeline_config.example.yaml
!config/reference_paths.example.yaml

# The real sample sheet names actual samples and holds absolute local paths.
# Only the template is tracked.
config/sample_sheet.tsv
config/sample_sheet_*.tsv
!config/sample_sheet.example.tsv

# Data (never commit patient/sample sequencing data)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Results are regenerated by the pipeline, not versioned
results/*/*
!results/*/.gitkeep

# The run manifest is written to results/ ROOT, not into a numbered subdirectory,
# so `results/*/*` above does not match it. It records real sample identifiers,
# absolute local paths and host names — the same class of content as the real
# config files, and equally not for GitHub.
results/*.tsv
results/*.txt
results/*.json

# Work/scratch and logs
logs/*
!logs/.gitkeep
work/
*.tmp

# Reference bundle (too large / license-restricted for git)
reference/
References/
*.fa
*.fa.fai
*.fasta
*.gtf
*.gtf.gz

# Methylation / alignment artifacts anywhere in the repo by accident.
# A whole-genome bedMethyl is ~660 MB gzipped — well past GitHub's limit, and
# it is patient data regardless.
*.bedmethyl
*.bedmethyl.gz
*.bedmethyl.gz.tbi
*.bed.gz
*.bed.gz.tbi
*.bam
*.bam.bai
*.cram
*.cram.crai
*.vcf
*.vcf.gz
*.vcf.gz.tbi

# Large generated annotation BEDs (rebuild from the GTF instead — see
# docs/REFERENCE_PREPARATION.md)
genes.bed
promoters_2kb.bed
cpg_islands_hg38*.bed

# R
.Rhistory
.RData
.Rproj.user/

# OS / editor cruft
.DS_Store
*.swp
.vscode/

# Exception: tests/fixtures/ contains deliberately-committed SYNTHETIC test
# data (no real patient data, hand-crafted for tests/run_tests.sh) — must
# override the blanket *.bedmethyl.gz / *.bed exclusions above, or the test
# suite breaks for anyone who clones this repo.
!tests/fixtures/
!tests/fixtures/**

# macOS AppleDouble metadata files (created when copying to/from
# non-native filesystems, e.g. external drives, network mounts).
# These appear as ._<filename> and WILL be picked up by input-file globs
# if not excluded.
._*
.AppleDouble
