# =============================================================================
# .gitignore for pipelines/snv/
#
# Paths here are relative to THIS directory. A pattern containing a slash is
# anchored to the directory holding the .gitignore, so these rules must live
# beside the pipeline, not just at the suite root — see pipelines/sv/.gitignore
# for the full explanation of why.
# =============================================================================

# Real, sample-specific / machine-specific configs — NEVER commit these.
# Only the .example.yaml templates are tracked.
config/pipeline_config.yaml
config/pipeline_config_*.yaml
config/reference_paths.yaml
!config/pipeline_config.example.yaml
!config/reference_paths.example.yaml

# Data (never commit patient/sample sequencing data)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Results are regenerated by the pipeline, not versioned
results/*/*
!results/*/.gitkeep

# Work/scratch and logs
logs/*
!logs/.gitkeep
work/
*.tmp

# Reference bundle (too large / license-restricted for git)
reference/
References/
*.fa
*.fa.fai
*.fasta
*.gtf
*.gtf.gz

# VCF/BAM/CRAM artifacts anywhere in the repo by accident
*.vcf
*.vcf.gz
*.vcf.gz.tbi
*.bam
*.bam.bai
*.cram
*.cram.crai

# R
.Rhistory
.RData
.Rproj.user/

# OS / editor cruft
.DS_Store
*.swp
.vscode/

# Exception: tests/fixtures/ will hold deliberately-committed SYNTHETIC test
# data once a test suite exists here — must override the blanket *.vcf.gz
# exclusion above when that day comes.
!tests/fixtures/
!tests/fixtures/**

# macOS AppleDouble metadata files (created when copying to/from non-native
# filesystems, e.g. external drives). Appear as ._<filename>.
._*
.AppleDouble
