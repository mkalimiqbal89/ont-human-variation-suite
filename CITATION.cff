    title: "Sniffles2"
    notes: "Structural variant caller used upstream by wf-human-variation"
  - type: software
    title: "modkit"
    notes: "Produces the bedMethyl pileup consumed by the methylation pipeline"
  - type: software
    title: "bedtools"
